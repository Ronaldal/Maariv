# Copy to `.env.local` and adjust (Next.js loads `.env.local` automatically).
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Public site origin (share links, fallback when Host is missing). Must match the port you
# actually open in the browser — it does NOT change which port `next dev` binds to.
# Default Next dev server is :3000. To run on e.g. :3008: `npm run dev -- -p 3008` (see package.json).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ASP.NET API base URL — server-side only; not bundled for the browser
BACKEND_API_URL=http://localhost:5226